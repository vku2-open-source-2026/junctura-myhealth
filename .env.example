# Optional overrides. For the local demo none are needed: the server reads the
# credentials file that `npm run demo:setup` (junctura-health) wrote for this app.
# Real environment variables win over that file. Never commit a real .env.
# MyHealth needs no backend secret: it forwards the signed-in patient's own token to Junctura.

# Where the junctura-health checkout lives (demo accounts and application ids).
# JUNCTURA_HEALTH_DIR=../junctura-health

# Use another credentials file instead of <JUNCTURA_HEALTH_DIR>/.junctura/demo/junctura-myhealth.env
# JUNCTURA_MYHEALTH_ENV=

# Gateway of Junctura DX-OS (Layer 1). Consents and the access log are read from here.
# JUNCTURA_URL=http://localhost:8080

# Public values of the Junctura identity provider and this app's browser (PKCE) client.
# JUNCTURA_ISSUER=http://localhost:8080/identity/realms/junctura
# JUNCTURA_WEB_CLIENT_ID=health-myhealth-web

# Address used to fetch the signing keys when the public issuer is not reachable from where MyHealth runs
# (for example in a container). Tokens are still checked against JUNCTURA_ISSUER.
# JUNCTURA_ISSUER_INTERNAL=

# Listening address. The default port 5183 is the one registered for the browser client.
# PORT=5183
# HOST=127.0.0.1

# SQLite file for what a patient writes about themselves. Delete it to start over.
# MYHEALTH_DB=data/myhealth.db
